# Copy to .env and fill in. .env is gitignored and must never be committed.
# Secrets are read from the environment only; they are never logged or persisted.

# --- Paycrest sender API (v2) ---
# Your OWN Paycrest sender API key and secret, from the Paycrest dashboard.
# Sent to the Paycrest API as the `API-Key` header. The adapter never reads a
# key from anywhere but this environment.
PAYCREST_API_KEY=
# HMAC secret used to verify inbound Paycrest webhook signatures.
PAYCREST_API_SECRET=

# --- Signing wallet (operator) ---
# Private key for the wallet that signs ONLY `approve` + `sprayToken` and holds
# the USDC being off-ramped. Non-custodial: this key never leaves the box and is
# never sent to the gateway or to Paycrest.
SPRAAY_WALLET_PRIVATE_KEY=

# --- Chain ---
# Base mainnet RPC URL (e.g. https://mainnet.base.org or a provider endpoint).
BASE_RPC_URL=https://mainnet.base.org

# --- Webhook receiver (Paycrest order status callbacks) ---
# Public URL Paycrest should POST order events to, and the local port to listen on.
WEBHOOK_URL=
WEBHOOK_PORT=8787

# --- Optional overrides ---
# Spraay batch gateway base URL. Defaults to https://gateway.spraay.app.
# SPRAAY_GATEWAY_URL=https://gateway.spraay.app
# Paycrest API base URL. Defaults to https://api.paycrest.io.
# PAYCREST_API_URL=https://api.paycrest.io
